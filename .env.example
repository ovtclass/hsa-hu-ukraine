# Set these variables in Netlify with Functions scope. Never commit real credentials.
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# false = required STARTTLS; true = implicit TLS (usually port 465)
SMTP_SECURE=false
SMTP_USER=info@example.com
SMTP_PASS=
APPLICATION_FROM=info@example.com
APPLICATION_TO=info@hsa.hu
# Alternative: MAIL_TRANSPORT=resend and RESEND_API_KEY=...

# Analytics: production-only, Functions scope. Generate separate random secrets.
ANALYTICS_ADMIN_PASSWORD=
ANALYTICS_HASH_SECRET=
